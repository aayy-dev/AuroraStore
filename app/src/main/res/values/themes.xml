<resources>

    <!--
      Window theme shown before Compose draws. Uses the fixed store palette (no wallpaper-based
      dynamic color) so launch matches the Compose theme in compose/theme/.
      -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="chipStyle">@style/Chip.Filter</item>
        <item name="bottomSheetStyle">@style/AppTheme.BottomSheetStyle</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/colorStoreSurface</item>
        <item name="colorPrimary">@color/colorStorePrimary</item>
        <item name="colorOnPrimary">@color/colorStoreOnPrimary</item>
        <item name="colorSurface">@color/colorStoreSurface</item>
        <item name="colorOnSurface">@color/colorStoreOnSurface</item>
        <item name="android:colorBackground">@color/colorStoreSurface</item>
    </style>

    <style name="AppTheme.Translucent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="colorPrimary">@color/colorStorePrimary</item>
        <item name="colorOnPrimary">@color/colorStoreOnPrimary</item>
    </style>

    <!-- Translucent variant with edge-to-edge transparent system bars (no status bar scrim) -->
    <style name="AppTheme.Translucent.Transparent">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.BottomSheetStyle" parent="Widget.Material3.BottomSheet" />

    <style name="Chip.Filter" parent="@style/Widget.Material3.Chip.Filter" />
</resources>
